  "l": [
   "Two radios listen first,",
   "hear silence,"
  ]
 },
 {
  "id": "l1b",
  "a": 2.26,
  "b": 4.672,
  "l": [
   "and still collide.",
   "How?"
  ]
 },
 {
  "id": "l2a",
  "a": 4.9,
  "b": 7.68,
  "l": [
   "The left and right phones",
   "both reach the middle one,"
  ]
 },
 {
  "id": "l2b",
  "a": 7.72,
  "b": 9.157,
  "l": [
   "but not each other."
  ]
 },
 {
  "id": "l3a",
  "a": 9.38,
  "b": 11.52,
  "l": [
   "So both hear silence,",
   "send,"
  ]
 },
 {
  "id": "l3b",
  "a": 11.56,
  "b": 13.66,
  "l": [
   "and their signals",
   "clash in the middle."
  ]
 },
 {
  "id": "l4a",
  "a": 13.89,
  "b": 15.77,
  "l": [
   "Listening happens",
   "at the sender."
  ]
 },
 {
  "id": "l4b",
  "a": 15.81,
  "b": 17.863,
  "l": [
   "Collisions happen",
   "at the receiver."
  ]
 },
 {
  "id": "l5a",
  "a": 18.09,
  "b": 19.29,
  "l": [
   "So Wi-Fi can ask first,"
  ]
 },
 {
  "id": "l5b",
  "a": 19.33,
  "b": 22.057,
  "l": [
   "and the middle replies:",
   "clear to send."
  ]
 },
 {
  "id": "l6a",
  "a": 22.28,
  "b": 24.58,
  "l": [
   "The far side catches",
   "that reply too,"
  ]
 },
 {
  "id": "l6b",
  "a": 24.62,
  "b": 25.991,
  "l": [
   "and waits its turn."
  ]
 },
 {
  "id": "l7a",
  "a": 26.24,
  "b": 29.855,
  "l": [
   "Message people nearby,",
   "even offline, with Meshline."
  ]
 }
