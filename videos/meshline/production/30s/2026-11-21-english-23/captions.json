[
 {
  "id": "l1a",
  "a": 0.2,
  "b": 1.54,
  "l": [
   "Why does your phone",
   "keep changing"
  ]
 },
 {
  "id": "l1b",
  "a": 1.58,
  "b": 3.216,
  "l": [
   "its Bluetooth address?"
  ]
 },
 {
  "id": "l2a",
  "a": 3.55,
  "b": 6.487,
  "l": [
   "A fixed address would let",
   "scanners follow you around."
  ]
 },
 {
  "id": "l3a",
  "a": 6.95,
  "b": 9.39,
  "l": [
   "So Android swaps in",
   "a new random address"
  ]
 },
 {
  "id": "l3b",
  "a": 9.43,
  "b": 11.504,
  "l": [
   "at least every 15 minutes."
  ]
 },
 {
  "id": "l4a",
  "a": 11.95,
  "b": 15.542,
  "l": [
   "To a stranger's scanner,",
   "it is a new device each time."
  ]
 },
 {
  "id": "l5a",
  "a": 16.05,
  "b": 18.37,
  "l": [
   "But paired devices",
   "share a secret key,"
  ]
 },
 {
  "id": "l5b",
  "a": 18.41,
  "b": 20.292,
  "l": [
   "so they still know it is you."
  ]
 },
 {
  "id": "l6a",
  "a": 21.05,
  "b": 23.17,
  "l": [
   "Your device name can",
   "still give you away,"
  ]
 },
 {
  "id": "l6b",
  "a": 23.21,
  "b": 24.617,
  "l": [
   "so keep it plain."
  ]
 },
 {
  "id": "l7a",
  "a": 25.56,
  "b": 28.36,
  "l": [
   "Download Meshline for",
   "private nearby messages,"
  ]
 },
 {
  "id": "l7b",
  "a": 28.4,
  "b": 29.846,
  "l": [
   "even offline."
  ]
 }
]