[
 {
  "id": "l1",
  "start": 0.2,
  "end": 3.886,
  "text": "\u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u092c\u0902\u0926, \u092b\u093f\u0930 \u092d\u0940 \u092e\u0948\u092a \u092a\u0930 \u0906\u092a\u0915\u0940 \u091c\u0917\u0939 \u0926\u093f\u0916 \u0930\u0939\u0940 \u0939\u0948?",
  "speech_band_db": 24.3
 },
 {
  "id": "l2",
  "start": 4.29,
  "end": 9.706,
  "text": "\u091c\u0940\u092a\u0940\u090f\u0938 \u0938\u0948\u091f\u0947\u0932\u093e\u0907\u091f \u090f\u0915\u0924\u0930\u092b\u093c\u093e \u0938\u093f\u0917\u094d\u0928\u0932 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902; \u092b\u093c\u094b\u0928 \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u0941\u0928\u0915\u0930 \u091c\u0917\u0939 \u0928\u093f\u0915\u093e\u0932\u0924\u093e \u0939\u0948\u0964",
  "speech_band_db": 22.0
 },
 {
  "id": "l3",
  "start": 10.11,
  "end": 12.315,
  "text": "\u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u0947\u091f\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0928\u0939\u0940\u0902\u0964",
  "speech_band_db": 25.0
 },
 {
  "id": "l4",
  "start": 12.71,
  "end": 17.097,
  "text": "\u092a\u0930 \u0938\u0921\u093c\u0915\u094b\u0902 \u0935\u093e\u0932\u093e \u0928\u0915\u094d\u0936\u093e \u0905\u0932\u0917 \u0939\u0948; \u0928\u092f\u093e \u0928\u0915\u094d\u0936\u093e \u0905\u0915\u094d\u0938\u0930 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0938\u0947 \u0906\u0924\u093e \u0939\u0948\u0964",
  "speech_band_db": 26.4
 },
 {
  "id": "l5",
  "start": 17.5,
  "end": 21.902,
  "text": "\u0938\u092b\u093c\u0930 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0935\u093e\u0908-\u092b\u093c\u093e\u0908 \u092a\u0930 \u092a\u0942\u0930\u0947 \u0930\u093e\u0938\u094d\u0924\u0947 \u0915\u093e \u0907\u0932\u093e\u0915\u093e \u0938\u0947\u0935 \u0915\u0930\u0915\u0947 \u091c\u093e\u0901\u091a \u0932\u0947\u0902\u0964",
  "speech_band_db": 23.6
 },
 {
  "id": "l6",
  "start": 22.3,
  "end": 25.32,
  "text": "\u0938\u0948\u091f\u0947\u0932\u093e\u0907\u091f \u091c\u0917\u0939 \u092c\u0924\u093e\u0924\u0947 \u0939\u0948\u0902, \u0938\u0947\u0935 \u0928\u0915\u094d\u0936\u093e \u0938\u0921\u093c\u0915\u0947\u0902\u0964",
  "speech_band_db": 24.8
 },
 {
  "id": "l7",
  "start": 26.0,
  "end": 29.732,
  "text": "\u092a\u093e\u0938 \u0935\u093e\u0932\u094b\u0902 \u0938\u0947 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092c\u093e\u0924 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0936\u0932\u093e\u0907\u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964",
