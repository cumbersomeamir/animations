[
 {
  "id": "l1",
  "start": 0.2,
  "end": 3.484,
  "text": "\u0926\u0940\u0935\u093e\u0930 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0917\u090f, \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u091f\u0942\u091f\u0928\u0947 \u0932\u0917\u0940?",
  "speech_band_db": 25.0
 },
 {
  "id": "l2",
  "start": 3.9,
  "end": 7.24,
  "text": "\u0939\u0947\u0921\u092b\u093c\u094b\u0928, \u092b\u093c\u094b\u0928 \u0938\u0947 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0930\u0947\u0921\u093f\u092f\u094b \u092a\u0930 \u0938\u0940\u0927\u0947 \u091c\u0941\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964",
  "speech_band_db": 23.9
 },
 {
  "id": "l3",
  "start": 7.66,
  "end": 12.831,
  "text": "\u092e\u094b\u091f\u0940 \u0915\u0902\u0915\u094d\u0930\u0940\u091f \u092f\u093e \u0927\u093e\u0924\u0941 \u0915\u0940 \u0926\u0940\u0935\u093e\u0930 \u0938\u093f\u0917\u094d\u0928\u0932 \u0915\u092e\u091c\u093c\u094b\u0930 \u0915\u0930\u0924\u0940 \u0939\u0948; \u0926\u0942\u0930\u0940 \u0914\u0930 \u0930\u0947\u0921\u093f\u092f\u094b-\u0936\u094b\u0930 \u092d\u0940\u0964",
  "speech_band_db": 23.4
 },
 {
  "id": "l4",
  "start": 13.25,
  "end": 18.374,
  "text": "\u091c\u093e\u0901\u091a: \u092b\u093c\u094b\u0928 \u0915\u0947 \u092a\u093e\u0938, \u092c\u093f\u0928\u093e \u0926\u0940\u0935\u093e\u0930 \u0906\u0907\u090f; \u0906\u0935\u093e\u091c\u093c \u0938\u0941\u0927\u0930\u0947, \u0924\u094b \u0935\u091c\u0939 \u0926\u0942\u0930\u0940 \u092f\u093e \u0930\u0941\u0915\u093e\u0935\u091f \u0925\u0940\u0964",
  "speech_band_db": 22.1
 },
 {
  "id": "l5",
  "start": 18.8,
  "end": 22.201,
  "text": "\u0938\u093f\u0917\u094d\u0928\u0932 \u092c\u093e\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u091f\u093e\u0935\u0930 \u0915\u0947 \u0939\u0948\u0902, \u0939\u0947\u0921\u092b\u093c\u094b\u0928 \u0932\u093f\u0902\u0915 \u0915\u0947 \u0928\u0939\u0940\u0902\u0964",
  "speech_band_db": 25.9
 },
 {
  "id": "l6",
  "start": 22.62,
  "end": 25.487,
  "text": "\u0938\u0940\u0927\u0947 \u0932\u093f\u0902\u0915 \u0915\u094b \u091a\u093e\u0939\u093f\u090f: \u0915\u092e \u0926\u0942\u0930\u0940, \u0938\u093e\u092b\u093c \u0930\u093e\u0938\u094d\u0924\u093e\u0964",
  "speech_band_db": 24.2
 },
 {
  "id": "l7",
  "start": 25.99,
  "end": 29.722,
  "text": "\u092a\u093e\u0938 \u0935\u093e\u0932\u094b\u0902 \u0938\u0947 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092c\u093e\u0924 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0936\u0932\u093e\u0907\u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964",
  "speech_band_db": 23.0
 }
]