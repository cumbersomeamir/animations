  ]
 },
 {
  "id": "l5b",
  "a": 19.07,
  "b": 20.977,
  "l": [
   "whatever your internet plan."
  ]
 },
 {
  "id": "l6a",
  "a": 21.18,
  "b": 22.46,
  "l": [
   "Pick a quieter channel,"
  ]
 },
 {
  "id": "l6b",
  "a": 22.5,
  "b": 25.541,
  "l": [
