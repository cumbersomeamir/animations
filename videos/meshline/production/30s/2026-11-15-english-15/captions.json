 },
 {
  "id": "l4a",
  "a": 12.08,
  "b": 13.5,
  "l": [
   "Pick the same number?"
  ]
 },
 {
  "id": "l4b",
  "a": 13.54,
  "b": 16.363,
  "l": [
   "They clash, and each",
   "doubles its waiting range."
  ]
 },
 {
  "id": "l5a",
  "a": 16.57,
  "b": 19.03,
  "l": [
