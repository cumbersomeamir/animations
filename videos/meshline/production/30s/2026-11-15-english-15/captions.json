  "l": [
   "When two transmit together,"
  ]
 },
 {
  "id": "l2b",
  "a": 5.49,
  "b": 7.05,
  "l": [
   "both get scrambled."
  ]
 },
 {
  "id": "l3a",
  "a": 7.26,
  "b": 9.02,
  "l": [
   "So Wi-Fi listens first,"
  ]
 },
 {
  "id": "l3b",
  "a": 9.06,
  "b": 11.883,
  "l": [
