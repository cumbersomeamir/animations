[
 {
  "id": "l1",
  "start": 0.25,
  "end": 3.299,
  "text": "\u090f\u092f\u0930\u092a\u094d\u0932\u0947\u0928 \u092e\u094b\u0921 \u0911\u0928, \u092b\u093f\u0930 \u092d\u0940 \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u091a\u0932 \u0930\u0939\u0947 \u0939\u0948\u0902?",
  "speech_band_db": 25.2
 },
 {
  "id": "l2",
  "start": 3.7,
  "end": 8.501,
  "text": "\u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0935\u093e\u0932\u093e \u0930\u0947\u0921\u093f\u092f\u094b \u092c\u0902\u0926 \u0915\u0930\u0915\u0947 \u091f\u093e\u0935\u0930 \u0938\u0947 \u091c\u0941\u0921\u093c\u093e\u0935 \u0915\u093e\u091f\u0924\u093e \u0939\u0948\u0964",
  "speech_band_db": 23.6
 },
 {
  "id": "l3",
  "start": 8.9,
  "end": 12.926,
  "text": "\u0935\u093e\u0908-\u092b\u093c\u093e\u0908, \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u092d\u0940 \u092c\u0902\u0926 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u092a\u0930 \u0926\u094b\u092c\u093e\u0930\u093e \u091a\u093e\u0932\u0942 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",
  "speech_band_db": 23.2
 },
 {
  "id": "l4",
  "start": 13.33,
  "end": 17.152,
  "text": "\u0924\u092c \u0908\u092f\u0930\u092c\u0921\u094d\u0938 \u092f\u093e \u092a\u093e\u0938 \u0915\u093e \u092b\u093c\u094b\u0928 \u0938\u0940\u0927\u0947 \u0930\u0947\u0921\u093f\u092f\u094b \u0938\u0947 \u091c\u0941\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
  "speech_band_db": 24.1
 },
 {
  "id": "l5",
  "start": 17.55,
  "end": 22.126,
  "text": "\u092a\u0930 \u092f\u0939 \u0932\u093f\u0902\u0915 \u0938\u0940\u092e\u093f\u0924 \u0926\u0942\u0930\u0940 \u0924\u0915 \u0939\u0940 \u091a\u0932\u0924\u093e \u0939\u0948; \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u093e\u0908-\u092b\u093c\u093e\u0908 \u091a\u093e\u0939\u093f\u090f\u0964",
  "speech_band_db": 20.4
 },
 {
  "id": "l6",
  "start": 22.53,
  "end": 25.818,
  "text": "\u092f\u093e\u0928\u0940 \u092f\u0939 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u093e\u091f\u0924\u093e \u0939\u0948, \u0939\u0930 \u0930\u0947\u0921\u093f\u092f\u094b \u0928\u0939\u0940\u0902\u0964",
  "speech_band_db": 25.6
 },
 {
  "id": "l7",
  "start": 26.25,
  "end": 29.413,
  "text": "\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0938\u0902\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0936\u0932\u093e\u0907\u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964",
  "speech_band_db": 20.7
 }
