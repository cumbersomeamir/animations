 "captions": [
  {
   "start": 0.0,
   "end": 2.58,
   "text": "चेकआउट पर कार्ट में चुपके से",
   "hl": [
    "चुपके",
    "से"
   ]
  },
  {
   "start": 2.58,
   "end": 4.7,
   "text": "₹49 का दान जुड़ गया।",
   "hl": [
    "₹49",
    "का",
    "दान"
   ]
  },
  {
   "start": 4.7,
   "end": 6.3,
   "text": "क्या यह कानूनी है?",
   "hl": [
    "कानूनी"
   ]
  },
  {
   "start": 6.3,
   "end": 11.18,
   "text": "सरकारी डार्क पैटर्न दिशानिर्देश इसे बास्केट स्नीकिंग कहते हैं:",
   "hl": [
    "बास्केट",
    "स्नीकिंग"
   ]
  },
  {
   "start": 11.18,
   "end": 16.65,
   "text": "बिना सहमति कोई सामान या दान जोड़कर कुल रकम बढ़ाना, जिस पर रोक है।",
   "hl": [
    "बिना",
    "सहमति",
    "रोक"
   ]
  },
  {
   "start": 16.65,
   "end": 20.95,
   "text": "पर अगर आपने खुद टिक करके दान चुना, तो यह स्नीकिंग नहीं।",
   "hl": [
    "खुद",
    "टिक"
   ]
  },
  {
   "start": 20.95,
   "end": 24.15,
   "text": "अनचाहा आइटम दिखे, तो स्क्रीनशॉट लेकर",
   "hl": [
    "स्क्रीनशॉट"
   ]
  },
  {
   "start": 24.15,
   "end": 26.45,
   "text": "1915 पर शिकायत करें।",
   "hl": [
    "1915"
   ]
  },
  {
   "start": 26.45,
   "end": 30.0,
   "text": "आसान कानून के लिए, कोर्टलेंस को फ़ॉलो करें।",
   "hl": [
    "कोर्टलेंस"
   ]
  }
