   "end": 4.8,
   "text": "and your licence is at home.",
   "hl": [
    "at",
    "home."
   ]
  },
  {
   "start": 4.8,
   "end": 6.8,
   "text": "India's motor vehicle rules say:",
   "hl": [
    "motor",
    "vehicle",
    "rules"
   ]
  },
  {
   "start": 6.8,
   "end": 8.85,
   "text": "you can show it in electronic form,",
   "hl": [
    "electronic",
    "form,"
   ]
  },
  {
   "start": 8.85,
   "end": 11.8,
   "text": "in DigiLocker, or the mParivahan app.",
