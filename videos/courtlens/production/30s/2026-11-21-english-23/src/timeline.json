   "text": "PAPER OR PHONE?",
   "hl": [
    "PHONE?"
   ],
   "hook": true
  },
  {
   "start": 1.3,
   "end": 2.9,
   "text": "You're stopped at a traffic check,",
   "hl": [
    "traffic",
    "check,"
