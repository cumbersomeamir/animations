  {
   "start": 0.0,
   "end": 1.7,
   "text": "YOUR DEGREE. THEIR LOCK?",
   "hl": [
    "THEIR",
    "LOCK?"
   ],
   "hook": true
  },
  {
   "start": 1.7,
   "end": 4.45,
   "text": "You resign. They say: pay up, or it stays.",
   "hl": [
    "pay",
    "up,"
   ]
  },
  {
   "start": 4.45,
   "end": 6.72,
   "text": "Handing originals over when you join?",
