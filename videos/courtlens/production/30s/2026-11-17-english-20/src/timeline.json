    "normal",
    "wear",
    "and",
    "tear."
   ]
  },
  {
   "start": 10.25,
   "end": 12.48,
   "text": "Repainting? The landlord's job,",
   "hl": [
    "landlord's",
    "job,"
   ]
  },
  {
   "start": 12.48,
   "end": 14.05,
   "text": "whatever the agreement says.",
