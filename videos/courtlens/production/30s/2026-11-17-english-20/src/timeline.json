   ]
  },
  {
   "start": 15.25,
   "end": 17.5,
   "text": "like a broken window, can be deducted.",
   "hl": [
    "deducted."
   ]
  },
  {
   "start": 17.5,
   "end": 19.0,
   "text": "The rest is due",
   "hl": [
    "rest"
   ]
  },
  {
   "start": 19.0,
   "end": 21.1,
   "text": "when the landlord takes the empty flat back.",
