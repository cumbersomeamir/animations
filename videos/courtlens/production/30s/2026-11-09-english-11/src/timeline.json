 "captions": [
  {
   "start": 0.0,
   "end": 1.8,
   "text": "Your landlord wants you out,",
   "hl": [
    "out,"
   ]
  },
  {
   "start": 1.8,
   "end": 3.55,
   "text": "and cuts the power to your flat.",
   "hl": [
    "cuts",
    "the",
    "power"
   ]
  },
  {
   "start": 3.55,
   "end": 5.4,
   "text": "Is that allowed in Tamil Nadu?",
   "hl": [
    "Tamil",
    "Nadu?"
   ]
  },
  {
   "start": 5.4,
   "end": 8.12,
   "text": "The state’s tenancy law says no landlord shall",
   "hl": [
    "no",
    "landlord",
    "shall"
   ]
  },
  {
   "start": 8.12,
   "end": 11.6,
   "text": "cut off essential supplies, electricity included.",
   "hl": [
    "electricity"
   ]
  },
  {
   "start": 11.6,
   "end": 15.3,
   "text": "Eviction needs a Rent Court order, on grounds the Act lists.",
   "hl": [
    "Rent",
    "Court",
    "order,"
   ]
  },
  {
   "start": 15.3,
   "end": 17.75,
   "text": "So complain to the Rent Authority.",
   "hl": [
    "Rent",
    "Authority."
   ]
  },
  {
   "start": 17.75,
   "end": 21.3,
   "text": "It can order the power restored at once, pending its inquiry.",
   "hl": [
    "restored",
    "at",
    "once,"
   ]
  },
  {
   "start": 21.3,
   "end": 24.1,
   "text": "Attach rent receipts, photos and dates.",
   "hl": [
    "receipts,",
    "photos"
   ]
  },
  {
   "start": 24.1,
   "end": 26.12,
   "text": "Other states have their own rules.",
   "hl": [
    "Other",
    "states"
   ]
  },
  {
   "start": 26.12,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
  }
 ],
