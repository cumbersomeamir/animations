   "start": 0.0,
   "end": 2.6,
   "text": "TORN NOTE. WORTHLESS?",
   "hl": [
    "WORTHLESS?"
   ],
   "hook": true
  },
  {
   "start": 2.6,
   "end": 5.1,
   "text": "The bank says: no account, no exchange.",
   "hl": [
    "no",
    "account,",
    "exchange."
   ]
  },
  {
   "start": 5.1,
   "end": 7.22,
   "text": "But RBI rules say every branch",
   "hl": [
    "every",
    "branch"
   ]
  },
  {
   "start": 7.22,
   "end": 10.0,
   "text": "must exchange notes, customer or not.",
   "hl": [
    "customer",
    "or",
    "not."
   ]
  },
  {
   "start": 10.0,
   "end": 12.0,
   "text": "Torn in two, nothing missing?",
   "hl": [
    "nothing",
    "missing?"
   ]
  },
  {
   "start": 12.0,
   "end": 14.75,
   "text": "That's soiled: exchanged free at the counter.",
   "hl": [
    "soiled:",
    "free"
   ]
  },
  {
   "start": 14.75,
   "end": 16.7,
   "text": "A piece gone? It's still accepted,",
   "hl": [
    "accepted,"
   ]
  },
  {
   "start": 16.7,
   "end": 20.45,
   "text": "and paid by what's left: full, half, or nothing.",
   "hl": [
    "what's",
    "left:"
   ]
  },
  {
   "start": 20.45,
   "end": 22.75,
   "text": "Refused? Make a written complaint.",
   "hl": [
    "written",
    "complaint."
   ]
  },
  {
   "start": 22.75,
   "end": 26.75,
   "text": "No reply in 30 days? Go to the RBI Ombudsman.",
   "hl": [
    "RBI",
    "Ombudsman."
