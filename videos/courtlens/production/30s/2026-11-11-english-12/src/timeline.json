  {
   "start": 0.0,
   "end": 2.85,
   "text": "THEIR HOUSE. YOUR HOME?",
   "hl": [
    "HOME?"
   ],
   "hook": true
  },
  {
   "start": 2.85,
   "end": 5.2,
   "text": "Can your landlord just let themselves in?",
   "hl": [
    "let",
    "themselves",
    "in?"
   ]
  },
  {
   "start": 5.2,
   "end": 8.45,
   "text": "In Tamil Nadu, the tenancy law draws the line.",
   "hl": [
    "Tamil",
    "Nadu,"
   ]
  },
  {
   "start": 8.45,
   "end": 10.95,
   "text": "They may enter for repairs, an inspection,",
   "hl": [
    "repairs,"
   ]
  },
  {
   "start": 10.95,
   "end": 12.95,
   "text": "or a reason in your agreement,",
   "hl": [
    "agreement,"
   ]
  },
  {
   "start": 12.95,
   "end": 16.05,
   "text": "with written notice at least 24 hours ahead,",
   "hl": [
    "24",
    "hours"
   ]
  },
  {
   "start": 16.05,
   "end": 20.95,
   "text": "saying why, which day, and a time between 7 a.m. and 8 p.m.",
   "hl": [
    "7",
    "a.m.",
    "and",
    "8",
    "p.m."
   ]
  },
  {
   "start": 20.95,
   "end": 23.8,
   "text": "No notice? Ask them to come back with one.",
   "hl": [
    "come",
    "back"
   ]
  },
  {
   "start": 23.8,
   "end": 26.75,
   "text": "If it keeps happening, the Rent Court can hear it.",
   "hl": [
