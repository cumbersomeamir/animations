 "captions": [
  {
   "start": 0.0,
   "end": 2.3,
   "text": "The ATM gave no cash,",
   "hl": [
    "no",
    "cash,"
   ]
  },
  {
   "start": 2.3,
   "end": 4.58,
   "text": "but ₹2,000 left your account.",
   "hl": [
    "₹2,000"
   ]
  },
  {
   "start": 4.58,
   "end": 5.9,
   "text": "Can the bank keep it?",
   "hl": [
    "keep"
   ]
  },
  {
   "start": 5.9,
   "end": 9.1,
   "text": "RBI rules say a failed ATM withdrawal",
   "hl": [
    "failed"
   ]
  },
  {
   "start": 9.1,
   "end": 11.82,
   "text": "must be credited back within 5 days.",
   "hl": [
    "5",
    "days."
   ]
  },
  {
   "start": 11.82,
   "end": 14.95,
   "text": "After that, your bank owes you ₹100 a day,",
   "hl": [
    "₹100",
    "a",
    "day,"
   ]
  },
  {
   "start": 14.95,
   "end": 16.32,
   "text": "without you asking.",
   "hl": [
    "asking."
   ]
  },
  {
   "start": 16.32,
   "end": 18.9,
   "text": "Three days late? That’s ₹300,",
   "hl": [
    "₹300,"
   ]
  },
  {
   "start": 18.9,
   "end": 21.12,
   "text": "even at another bank’s ATM.",
   "hl": [
    "another",
    "bank’s"
   ]
  },
  {
   "start": 21.12,
   "end": 23.3,
   "text": "Not back? Complain to your bank,",
   "hl": [
    "Complain"
   ]
  },
  {
   "start": 23.3,
   "end": 26.12,
   "text": "and after 30 days, to the RBI Ombudsman.",
   "hl": [
    "RBI",
    "Ombudsman."
   ]
  },
  {
   "start": 26.12,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
  }
 ],
