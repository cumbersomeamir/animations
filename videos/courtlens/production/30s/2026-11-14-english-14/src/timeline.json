 "captions": [
  {
   "start": 0.0,
   "end": 2.5,
   "text": "WRONG BILL. LIGHTS OUT?",
   "hl": [
    "OUT?",
    "LIGHTS"
   ],
   "hook": true
  },
  {
   "start": 2.5,
   "end": 5.5,
   "text": "The company says: pay it all, or we cut you off.",
   "hl": [
    "cut",
    "you",
    "off."
   ]
  },
  {
   "start": 5.5,
   "end": 9.95,
   "text": "But the Electricity Act requires 15 clear days' written notice first.",
   "hl": [
    "15",
    "clear",
    "days'"
   ]
  },
  {
   "start": 9.95,
   "end": 12.84,
   "text": "Disputing the bill? Deposit, under protest,",
   "hl": [
    "under",
    "protest,"
   ]
  },
  {
   "start": 12.84,
   "end": 15.04,
   "text": "the lower amount: what they claim,",
   "hl": [
    "lower",
    "amount:"
   ]
  },
  {
   "start": 15.04,
   "end": 17.75,
   "text": "or your six-month average for each month.",
   "hl": [
    "six-month",
    "average"
   ]
  },
  {
   "start": 17.75,
   "end": 21.25,
   "text": "Then they can't cut you off while the dispute is pending.",
   "hl": [
    "can't",
    "cut",
    "you",
    "off"
   ]
  },
  {
   "start": 21.25,
   "end": 23.0,
   "text": "So put your dispute in writing,",
   "hl": [
    "writing,"
   ]
  },
  {
   "start": 23.0,
   "end": 26.75,
   "text": "pay the lower amount, and keep the receipt.",
   "hl": [
    "receipt."
   ]
  },
  {
   "start": 26.75,
   "end": 30.0,
