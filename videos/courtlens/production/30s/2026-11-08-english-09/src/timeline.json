  {
   "start": 0.0,
   "end": 2.3,
   "text": "The hotel wants your original Aadhaar",
   "hl": [
    "original",
    "Aadhaar"
   ]
  },
  {
   "start": 2.3,
   "end": 4.5,
   "text": "as a deposit till checkout.",
   "hl": [
    "deposit"
   ]
  },
  {
   "start": 4.5,
   "end": 5.95,
   "text": "Do you have to leave it?",
   "hl": [
    "leave"
   ]
  },
  {
   "start": 5.95,
   "end": 8.66,
   "text": "Aadhaar’s own rules let a hotel verify it,",
   "hl": [
    "verify"
   ]
  },
  {
   "start": 8.66,
   "end": 11.65,
   "text": "by scanning its QR code with your consent.",
   "hl": [
    "QR",
    "code"
   ]
  },
  {
   "start": 11.65,
   "end": 14.45,
   "text": "It shouldn’t collect or store your Aadhaar number,",
   "hl": [
    "collect",
    "or",
    "store"
   ]
  },
  {
   "start": 14.45,
   "end": 16.75,
   "text": "and any copy it keeps must be masked.",
   "hl": [
    "masked."
   ]
  },
  {
   "start": 16.75,
   "end": 18.8,
   "text": "So showing your card is normal;",
   "hl": [
    "normal;"
   ]
  },
  {
   "start": 18.8,
   "end": 21.6,
   "text": "leaving the original isn’t part of the process.",
   "hl": [
    "isn’t",
    "part"
   ]
  },
  {
   "start": 21.6,
   "end": 23.85,
   "text": "Ask them to scan it and hand it back,",
   "hl": [
    "hand",
    "it",
    "back,"
   ]
  },
  {
   "start": 23.85,
   "end": 26.12,
   "text": "or offer another ID they accept.",
   "hl": [
    "another",
    "ID"
   ]
  },
  {
   "start": 26.12,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
