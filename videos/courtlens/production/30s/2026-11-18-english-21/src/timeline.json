 "captions": [
  {
   "start": 0.0,
   "end": 1.45,
   "text": "PAY EARLY. GET FINED?",
   "hl": [
    "GET",
    "FINED?"
   ],
   "hook": true
  },
  {
   "start": 1.45,
   "end": 3.3,
   "text": "You want to close your loan early.",
   "hl": [
    "loan",
    "early."
   ]
  },
  {
   "start": 3.3,
   "end": 5.55,
   "text": "The lender adds a 2% charge.",
   "hl": [
    "2%",
    "charge."
   ]
  },
  {
   "start": 5.55,
   "end": 6.95,
   "text": "RBI rules say:",
   "hl": [
    "RBI"
   ]
  },
  {
   "start": 6.95,
   "end": 8.85,
   "text": "On a floating-rate loan",
   "hl": [
    "floating-rate"
   ]
  },
  {
   "start": 8.85,
   "end": 10.3,
   "text": "you took for anything but business,",
   "hl": [
    "but",
    "business,"
   ]
  },
  {
   "start": 10.3,
   "end": 12.0,
   "text": "banks and finance companies",
   "hl": [
    "banks",
    "finance",
    "companies"
   ]
  },
  {
   "start": 12.0,
   "end": 14.2,
   "text": "can't charge you for paying early.",
   "hl": [
    "can't",
    "charge"
   ]
  },
  {
   "start": 14.2,
   "end": 15.75,
   "text": "Part or full,",
   "hl": [
    "Part",
    "full,"
   ]
  },
  {
   "start": 15.75,
   "end": 17.3,
   "text": "even with money from a new lender.",
   "hl": [
    "new",
    "lender."
   ]
  },
  {
   "start": 17.3,
   "end": 19.85,
   "text": "Fixed rate? A charge may apply,",
   "hl": [
    "Fixed",
    "rate?"
   ]
  },
  {
   "start": 19.85,
   "end": 21.45,
   "text": "if your loan papers disclose it.",
   "hl": [
    "disclose"
   ]
  },
  {
   "start": 21.45,
   "end": 22.85,
   "text": "Before you prepay,",
   "hl": [
    "prepay,"
   ]
  },
  {
   "start": 22.85,
   "end": 26.75,
   "text": "check floating or fixed in your sanction letter.",
   "hl": [
    "sanction",
    "letter."
   ]
  },
  {
   "start": 26.75,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
  }
 ],
