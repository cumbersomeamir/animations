  "captions": [
    {"start": 0.00, "end": 4.20, "text": "फ़ोन पर मकान मालिक ने डिपॉज़िट लौटाने का वादा किया,", "hl": ["डिपॉज़िट", "लौटाने"]},
    {"start": 4.20, "end": 5.85, "text": "आपने कॉल रिकॉर्ड की।", "hl": ["रिकॉर्ड"]},
    {"start": 5.85, "end": 7.50, "text": "क्या यह कानूनी है?", "hl": ["कानूनी"]},
    {"start": 7.50, "end": 12.02, "text": "सुप्रीम कोर्ट कहता है: गुप्त रिकॉर्डिंग भी सबूत बन सकती है,", "hl": ["सबूत"]},
    {"start": 12.02, "end": 17.20, "text": "बशर्ते बात मामले की हो, आवाज़ पहचानी जाए और उसमें बदलाव न हो।", "hl": ["मामले", "आवाज़", "बदलाव"]},
    {"start": 17.20, "end": 19.45, "text": "पोस्ट करना अलग मामला है:", "hl": ["अलग", "मामला"]},
    {"start": 19.45, "end": 24.00, "text": "बिना सहमति निजी बातें फैलाने पर हर्जाने का दावा हो सकता है।", "hl": ["हर्जाने", "का", "दावा"]},
    {"start": 24.00, "end": 26.55, "text": "मूल फ़ाइल बिना एडिट किए रखें।", "hl": ["मूल", "फ़ाइल"]},
    {"start": 26.55, "end": 30.00, "text": "आसान कानून के लिए, कोर्टलेंस को फ़ॉलो करें।", "hl": ["कोर्टलेंस"]}
