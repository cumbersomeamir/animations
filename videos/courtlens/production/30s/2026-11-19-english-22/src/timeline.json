  {
   "start": 8.85,
   "end": 10.4,
   "text": "the car is in its care,",
   "hl": [
    "its",
    "care,"
   ]
  },
  {
   "start": 10.4,
   "end": 12.45,
   "text": "even if the valet service is free.",
   "hl": [
    "free."
   ]
  },
  {
   "start": 12.45,
   "end": 14.3,
   "text": "Lost or damaged?",
