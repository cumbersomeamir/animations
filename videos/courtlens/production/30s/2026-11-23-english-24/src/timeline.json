 "captions": [
  {
   "start": 0.0,
   "end": 1.75,
   "text": "LOCKER ROBBED. WHO PAYS?",
   "hl": [
    "WHO",
    "PAYS?"
   ],
   "hook": true
  },
  {
   "start": 1.75,
   "end": 3.75,
   "text": "Thieves break into the bank's vault,",
   "hl": [
    "vault,"
   ]
  },
  {
   "start": 3.75,
   "end": 5.35,
   "text": "and your jewellery is gone.",
   "hl": [
    "gone."
   ]
  },
  {
   "start": 5.35,
   "end": 7.1,
   "text": "RBI's locker rules say:",
   "hl": [
    "RBI's"
   ]
  },
  {
   "start": 7.1,
   "end": 10.05,
   "text": "for theft, robbery, fire or a building collapse,",
   "hl": [
    "theft,",
    "robbery,"
   ]
  },
  {
   "start": 10.05,
   "end": 11.95,
   "text": "or fraud by the bank's own staff,",
   "hl": [
    "fraud"
   ]
  },
  {
   "start": 11.95,
   "end": 15.05,
   "text": "the bank pays 100 times your yearly locker rent.",
   "hl": [
    "100",
    "times"
   ]
  },
  {
   "start": 15.05,
   "end": 17.0,
   "text": "Floods or earthquakes?",
   "hl": [
    "Floods",
    "or",
    "earthquakes?"
   ]
  },
  {
   "start": 17.0,
   "end": 18.8,
   "text": "The bank isn't liable for those.",
   "hl": [
    "isn't",
    "liable"
   ]
  },
  {
   "start": 18.8,
   "end": 21.75,
   "text": "And banks can't sell you insurance for what's inside.",
   "hl": [
    "can't",
    "sell"
   ]
  },
  {
   "start": 21.75,
   "end": 23.65,
   "text": "So check your yearly rent,",
   "hl": [
    "yearly",
    "rent,"
   ]
  },
  {
   "start": 23.65,
   "end": 26.75,
   "text": "and buy your own insurance for costly valuables.",
   "hl": [
    "own",
    "insurance"
   ]
  },
  {
   "start": 26.75,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
  }
 ],
