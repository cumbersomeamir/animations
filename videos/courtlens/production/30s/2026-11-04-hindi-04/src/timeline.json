 "captions": [
  {
   "start": 0.0,
   "end": 2.05,
   "text": "केतली तीसरे दिन लीक हुई;",
   "hl": [
    "लीक"
   ]
  },
  {
   "start": 2.05,
   "end": 5.3,
   "text": "दुकानदार बोला: बिल पर लिखा है, रिफ़ंड नहीं।",
   "hl": [
    "रिफ़ंड",
    "नहीं।"
   ]
  },
  {
   "start": 5.3,
   "end": 6.85,
   "text": "क्या यह चलेगा?",
   "hl": [
    "चलेगा?"
   ]
  },
  {
   "start": 6.85,
   "end": 11.75,
   "text": "उपभोक्ता कानून में खराब सामान वापस न लेना, पैसे न लौटाना",
   "hl": [
    "खराब",
    "सामान"
   ]
  },
  {
   "start": 11.75,
   "end": 13.5,
   "text": "अनुचित व्यापार प्रथा है,",
   "hl": [
    "अनुचित",
    "व्यापार",
    "प्रथा"
   ]
  },
  {
   "start": 13.5,
   "end": 17.15,
   "text": "बिल में लिखी अवधि में, वरना 30 दिनों के भीतर।",
   "hl": [
    "30",
    "दिनों"
   ]
  },
  {
   "start": 17.15,
   "end": 20.55,
   "text": "मन बदला हो, तो वापसी दुकान की नीति पर है।",
   "hl": [
    "दुकान",
    "की",
    "नीति"
   ]
  },
  {
   "start": 20.55,
   "end": 23.0,
   "text": "बिल और खराबी की फ़ोटो रखें,",
   "hl": [
    "बिल",
    "फ़ोटो"
   ]
  },
  {
   "start": 23.0,
   "end": 26.6,
   "text": "लिखित शिकायत दें, फिर 1915 पर कॉल करें।",
   "hl": [
    "1915"
   ]
  },
  {
   "start": 26.6,
   "end": 30.0,
   "text": "आसान कानून के लिए, कोर्टलेंस को फ़ॉलो करें।",
   "hl": [
    "कोर्टलेंस"
   ]
  }
 ],
