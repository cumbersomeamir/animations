  "captions": [
    {"start": 0.00, "end": 2.62, "text": "The bottle says MRP ₹20.", "hl": ["MRP", "₹20."]},
    {"start": 2.62, "end": 5.60, "text": "The shop wants ₹25, because it’s chilled.", "hl": ["₹25,"]},
    {"start": 5.60, "end": 7.25, "text": "Is that legal in India?", "hl": ["India?"]},
    {"start": 7.25, "end": 10.70, "text": "Packaged goods must carry a maximum retail price,", "hl": ["maximum", "retail", "price,"]},
    {"start": 10.70, "end": 13.05, "text": "and it already includes all taxes.", "hl": ["all", "taxes."]},
    {"start": 13.05, "end": 15.65, "text": "A shop can’t sell above it, chilled or not.", "hl": ["can’t", "sell", "above", "it,"]},
    {"start": 15.65, "end": 18.90, "text": "Restaurants and hotels serving you are a different case.", "hl": ["different", "case."]},
    {"start": 18.95, "end": 21.50, "text": "Overcharged? Keep the bill,", "hl": ["bill,"]},
    {"start": 21.50, "end": 22.65, "text": "snap the label,", "hl": ["label,"]},
    {"start": 22.65, "end": 24.75, "text": "and contact the National Consumer Helpline:", "hl": ["National", "Consumer", "Helpline:"]},
    {"start": 24.75, "end": 26.45, "text": "1915", "hl": ["1915"]},
