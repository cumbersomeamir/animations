 "captions": [
  {
   "start": 0.0,
   "end": 2.95,
   "text": "The cashier says: no phone number, no bill.",
   "hl": [
    "phone",
    "number,"
   ]
  },
  {
   "start": 2.95,
   "end": 4.4,
   "text": "Can they insist?",
   "hl": [
    "insist?"
   ]
  },
  {
   "start": 4.4,
   "end": 7.8,
   "text": "Consumer law lists not issuing a bill for goods sold",
   "hl": [
    "not",
    "issuing",
    "a",
    "bill"
   ]
  },
  {
   "start": 7.8,
   "end": 9.85,
   "text": "as an unfair trade practice.",
   "hl": [
    "unfair",
    "trade",
    "practice."
   ]
  },
  {
   "start": 9.85,
   "end": 13.95,
   "text": "And GST invoice rules don’t ask for your phone number at all.",
   "hl": [
    "don’t",
    "ask"
   ]
  },
  {
   "start": 13.95,
   "end": 16.95,
   "text": "Loyalty points or an e-bill are extras;",
   "hl": [
    "extras;"
   ]
  },
  {
   "start": 16.95,
   "end": 19.5,
   "text": "sharing your number for those is your choice.",
   "hl": [
    "your",
    "choice."
   ]
  },
  {
   "start": 19.5,
   "end": 22.85,
   "text": "Say politely: a printed bill without my number, please.",
   "hl": [
    "printed",
    "bill"
   ]
  },
  {
   "start": 22.85,
   "end": 26.0,
   "text": "Still refused? Call 1915.",
   "hl": [
    "1915."
   ]
  },
  {
   "start": 26.0,
   "end": 30.0,
   "text": "Follow Courtlens for everyday Indian law, explained.",
   "hl": [
    "Courtlens"
   ]
  }
