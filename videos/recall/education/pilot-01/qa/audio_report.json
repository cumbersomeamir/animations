    {
      "id": "n1a",
      "start": 0.35,
      "end": 1.672,
      "text": "A steel ball sinks.",
      "words": 4,
      "words_per_s": 3.03,
      "voice_over_bed_db": 9.9
    },
    {
      "id": "n1b",
      "start": 1.92,
      "end": 3.675,
      "text": "So how do steel ships float?",
      "words": 6,
      "words_per_s": 3.42,
      "voice_over_bed_db": 11.3
    },
    {
      "id": "n2",
      "start": 4.2,
      "end": 6.292,
      "text": "It pushes aside only a little water.",
      "words": 7,
      "words_per_s": 3.35,
      "voice_over_bed_db": 13.3
    },
    {
      "id": "n3a",
      "start": 6.85,
      "end": 8.703,
      "text": "Same steel, as a hollow hull,",
      "words": 6,
      "words_per_s": 3.24,
      "voice_over_bed_db": 10.9
    },
    {
      "id": "n3b",
      "start": 9.05,
      "end": 10.824,
      "text": "pushes aside much more water.",
      "words": 5,
      "words_per_s": 2.82,
      "voice_over_bed_db": 10.3
    },
    {
      "id": "n4",
      "start": 11.1,
      "end": 14.37,
      "text": "Steel plus air is, on average, less dense than water.",
      "words": 10,
      "words_per_s": 3.06,
      "voice_over_bed_db": 13.0
    }
