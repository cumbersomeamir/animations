  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.154,
      "text": "How does it see smoke?",
      "words": 5,
      "words_per_s": 4.53,
      "voice_over_bed_db": 17.5
    },
    {
      "id": "l02",
      "start": 1.45,
      "end": 4.938,
      "text": "Burnt toast, and it screams. But what's in that plastic box?",
      "words": 11,
      "words_per_s": 3.15,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l03",
      "start": 5.25,
      "end": 8.163,
      "text": "Many alarms hide a small chamber with a tiny light.",
      "words": 10,
      "words_per_s": 3.43,
      "voice_over_bed_db": 18.2
    },
    {
      "id": "l04",
      "start": 8.45,
      "end": 12.05,
      "text": "The light aims away from the sensor, so normally it sees nothing.",
      "words": 12,
      "words_per_s": 3.33,
      "voice_over_bed_db": 17.0
    },
    {
      "id": "l05",
      "start": 12.35,
      "end": 16.339,
      "text": "When smoke drifts in, particles scatter the light, and some hits the sensor.",
      "words": 13,
      "words_per_s": 3.26,
      "voice_over_bed_db": 17.4
    },
    {
      "id": "l06",
      "start": 16.6,
      "end": 18.417,
      "text": "Enough light, and the alarm sounds.",
      "words": 6,
      "words_per_s": 3.3,
      "voice_over_bed_db": 17.6
    },
    {
      "id": "l07",
      "start": 18.85,
      "end": 21.801,
      "text": "Thick steam can set it off too, even with no fire.",
      "words": 11,
      "words_per_s": 3.73,
      "voice_over_bed_db": 16.1
    },
    {
      "id": "l08",
      "start": 22.2,
      "end": 25.064,
      "text": "So test yours once a month, using the test button.",
      "words": 10,
      "words_per_s": 3.49,
      "voice_over_bed_db": 16.7
    },
    {
      "id": "l09",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
