   "end": 10.49,
   "first_word_s": 8.45,
   "last_word_s": 9.65,
   "caption_lead_s": 0.0,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "so normally it / sees nothing.",
   "start": 10.49,
   "end": 12.35,
   "first_word_s": 10.49,
   "last_word_s": 11.39,
   "caption_lead_s": -0.0,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "When smoke drifts in,",
   "start": 12.35,
   "end": 13.65,
