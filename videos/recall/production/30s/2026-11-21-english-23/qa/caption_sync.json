   "first_word_s": 3.25,
   "last_word_s": 4.17,
   "caption_lead_s": 0.0,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "Many alarms hide a small / chamber with a tiny light.",
   "start": 5.25,
   "end": 8.45,
   "first_word_s": 5.25,
   "last_word_s": 7.49,
   "caption_lead_s": 0.0,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "The light aims away / from the sensor,",
