  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.944,
      "text": "Same slider, opposite jobs.",
      "words": 4,
      "words_per_s": 2.11,
      "voice_over_bed_db": 17.1
    },
    {
      "id": "l02",
      "start": 2.15,
      "end": 5.589,
      "text": "Pull it one way, the teeth lock. Pull it back, they open. How?",
      "words": 13,
      "words_per_s": 3.78,
      "voice_over_bed_db": 16.5
    },
    {
      "id": "l03",
      "start": 5.82,
      "end": 8.475,
      "text": "Inside, the slider's channel is shaped like a Y.",
      "words": 9,
      "words_per_s": 3.39,
      "voice_over_bed_db": 18.9
    },
    {
      "id": "l04",
      "start": 8.7,
      "end": 11.752,
      "text": "Closing, its slanted walls squeeze both rows together.",
      "words": 8,
      "words_per_s": 2.62,
      "voice_over_bed_db": 18.2
    },
    {
      "id": "l05",
      "start": 11.98,
      "end": 16.27,
      "text": "Each tooth has a bump and a hollow, so each bump nests in the next hollow.",
      "words": 16,
      "words_per_s": 3.73,
      "voice_over_bed_db": 17.1
    },
    {
      "id": "l06",
      "start": 16.5,
      "end": 18.799,
      "text": "Nested, they hardly pull apart sideways.",
      "words": 6,
      "words_per_s": 2.61,
      "voice_over_bed_db": 17.7
    },
    {
      "id": "l07",
      "start": 19.03,
      "end": 21.998,
      "text": "Opening, a wedge between the arms splits them apart.",
      "words": 9,
      "words_per_s": 3.03,
      "voice_over_bed_db": 17.7
    },
    {
      "id": "l08",
      "start": 22.25,
      "end": 25.122,
      "text": "And many sliders hold still until you pull the tab.",
      "words": 10,
      "words_per_s": 3.48,
      "voice_over_bed_db": 16.1
    },
    {
      "id": "l09",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
