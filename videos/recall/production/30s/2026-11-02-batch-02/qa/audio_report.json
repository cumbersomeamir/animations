  "lines": [
    {
      "id": "l01",
      "start": 0.35,
      "end": 4.292,
      "text": "Which has more mass: a kilogram of steel, or a kilogram of feathers?",
      "words": 13,
      "words_per_s": 3.3,
      "voice_over_bed_db": 12.0
    },
    {
      "id": "l02",
      "start": 4.6,
      "end": 5.384,
      "text": "Take a moment.",
      "words": 3,
      "words_per_s": 3.83,
      "voice_over_bed_db": 14.9
    },
    {
      "id": "l03",
      "start": 8.45,
      "end": 10.496,
      "text": "Same mass: one kilogram each.",
      "words": 5,
      "words_per_s": 2.44,
      "voice_over_bed_db": 10.7
    },
    {
      "id": "l04",
      "start": 10.85,
      "end": 15.856,
      "text": "The feathers just take up far more space. As a pile, their density is much lower.",
      "words": 16,
      "words_per_s": 3.2,
      "voice_over_bed_db": 9.6
    },
    {
      "id": "l05",
      "start": 16.15,
      "end": 18.656,
      "text": "Now flip it: two boxes of the same size.",
      "words": 9,
      "words_per_s": 3.59,
      "voice_over_bed_db": 10.3
    },
    {
      "id": "l06",
      "start": 19.45,
      "end": 21.15,
      "text": "The steel box has far more mass.",
      "words": 7,
      "words_per_s": 4.12,
      "voice_over_bed_db": 10.1
    },
    {
      "id": "l07",
      "start": 23.05,
      "end": 26.805,
      "text": "The trick: notice what the question keeps equal, mass or volume.",
      "words": 11,
      "words_per_s": 2.93,
      "voice_over_bed_db": 11.4
    },
    {
      "id": "l08",
      "start": 27.15,
      "end": 29.077,
      "text": "Change that, and you change the answer.",
      "words": 7,
      "words_per_s": 3.63,
      "voice_over_bed_db": 10.7
    }
  ],
