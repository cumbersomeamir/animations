    {
      "id": "l01",
      "start": 0.4,
      "end": 4.471,
      "text": "Why does your phone rush to 80% then crawl to 100%?",
      "words": 11,
      "words_per_s": 2.7,
      "voice_over_bed_db": 16.2
    },
    {
      "id": "l02",
      "start": 4.85,
      "end": 8.761,
      "text": "At first, the charger pushes a big, steady current into the battery.",
      "words": 12,
      "words_per_s": 3.07,
      "voice_over_bed_db": 15.3
    },
    {
      "id": "l03",
      "start": 9.2,
      "end": 15.512,
      "text": "Near full, it holds the voltage steady and lets the current shrink, like pouring slower near the top of a glass.",
      "words": 21,
      "words_per_s": 3.33,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l04",
      "start": 15.95,
      "end": 23.614,
      "text": "That gentler finish helps the battery last. Keep it cool, too: when it's too warm, charging past 80% can pause.",
      "words": 20,
      "words_per_s": 2.61,
      "voice_over_bed_db": 16.3
    },
    {
      "id": "l05",
      "start": 26.35,
      "end": 29.639,
      "text": "Download Recall for learning any new subject with AI.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 16.7
    }
  ],
