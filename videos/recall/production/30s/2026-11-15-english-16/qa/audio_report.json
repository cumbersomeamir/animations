  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 0.973,
      "text": "That is my voice?",
      "words": 4,
      "words_per_s": 4.33,
      "voice_over_bed_db": 20.0
    },
    {
      "id": "l02",
      "start": 1.3,
      "end": 3.094,
      "text": "Your friends hear this voice every day.",
      "words": 7,
      "words_per_s": 3.9,
      "voice_over_bed_db": 18.6
    },
    {
      "id": "l03",
      "start": 4.45,
      "end": 5.725,
      "text": "You hear yourself two ways.",
      "words": 5,
      "words_per_s": 3.92,
      "voice_over_bed_db": 20.3
    },
    {
      "id": "l04",
      "start": 6.1,
      "end": 8.229,
      "text": "Through the air, from your mouth to your ears.",
      "words": 9,
      "words_per_s": 4.23,
      "voice_over_bed_db": 17.7
    },
    {
      "id": "l05",
      "start": 8.6,
      "end": 12.679,
      "text": "And through bone: your skull carries the vibrations to your inner ears.",
      "words": 12,
      "words_per_s": 2.94,
      "voice_over_bed_db": 15.9
    },
    {
      "id": "l06",
      "start": 13.1,
      "end": 16.019,
      "text": "That inner path changes the sound, and only you get it.",
      "words": 11,
      "words_per_s": 3.77,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l07",
      "start": 16.5,
      "end": 20.544,
      "text": "A microphone only catches the air path, like everyone else's ears.",
      "words": 11,
      "words_per_s": 2.72,
      "voice_over_bed_db": 16.6
    },
    {
      "id": "l08",
      "start": 21.15,
      "end": 22.257,
      "text": "Plug your ears and hum.",
      "words": 5,
      "words_per_s": 4.52,
      "voice_over_bed_db": 18.3
    },
    {
      "id": "l09",
      "start": 23.6,
      "end": 25.636,
      "text": "It gets louder: that's the bone path.",
      "words": 7,
      "words_per_s": 3.44,
      "voice_over_bed_db": 15.7
    },
    {
      "id": "l10",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
