  "lines": [
    {
      "id": "l01",
      "text": "That is my voice?",
      "file": "l01.wav",
      "duration": 0.923,
      "sr": 24000,
      "words_per_s": 4.33
    },
    {
      "id": "l02",
      "text": "Your friends hear this voice every day.",
      "file": "l02.wav",
      "duration": 1.794,
      "sr": 24000,
      "words_per_s": 3.9
    },
    {
      "id": "l03",
      "text": "You hear yourself two ways.",
      "file": "l03.wav",
      "duration": 1.275,
      "sr": 24000,
      "words_per_s": 3.92
    },
    {
      "id": "l04",
      "text": "Through the air, from your mouth to your ears.",
      "file": "l04.wav",
      "duration": 2.129,
      "sr": 24000,
      "words_per_s": 4.23
    },
    {
      "id": "l05",
      "text": "And through bone: your skull carries the vibrations to your inner ears.",
      "file": "l05.wav",
      "duration": 4.079,
      "sr": 24000,
      "words_per_s": 2.94
    },
    {
      "id": "l06",
      "text": "That inner path changes the sound, and only you get it.",
      "file": "l06.wav",
      "duration": 2.919,
      "sr": 24000,
      "words_per_s": 3.77
    },
    {
      "id": "l07",
      "text": "A microphone only catches the air path, like everyone else's ears.",
      "file": "l07.wav",
      "duration": 4.044,
      "sr": 24000,
      "words_per_s": 2.72
    },
    {
      "id": "l08",
      "text": "Plug your ears and hum.",
      "file": "l08.wav",
      "duration": 1.107,
      "sr": 24000,
      "words_per_s": 4.52
    },
    {
      "id": "l09",
      "text": "It gets louder: that's the bone path.",
      "file": "l09.wav",
      "duration": 2.036,
      "sr": 24000,
      "words_per_s": 3.44
    },
    {
      "id": "l10",
      "text": "Download Recall to turn your study material into lessons.",
      "file": "l10.wav",
      "duration": 3.283,
      "sr": 24000,
      "words_per_s": 2.74
    }
  ]
