  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.04,
      "text": "Where's this water from?",
      "words": 4,
      "words_per_s": 4.04,
      "voice_over_bed_db": 20.6
    },
    {
      "id": "l02",
      "start": 1.35,
      "end": 4.717,
      "text": "It isn't leaking: the drink is orange, but the drops are clear.",
      "words": 12,
      "words_per_s": 3.56,
      "voice_over_bed_db": 17.1
    },
    {
      "id": "l03",
      "start": 5.05,
      "end": 8.094,
      "text": "The air around you contains invisible water vapor.",
      "words": 8,
      "words_per_s": 2.63,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l04",
      "start": 8.4,
      "end": 11.622,
      "text": "Near the icy glass, that air cools below its dew point.",
      "words": 11,
      "words_per_s": 3.41,
      "voice_over_bed_db": 18.0
    },
    {
      "id": "l05",
      "start": 11.95,
      "end": 17.139,
      "text": "Vapor molecules then stick to the cold glass faster than they escape, forming drops.",
      "words": 14,
      "words_per_s": 2.7,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l06",
      "start": 17.45,
      "end": 21.635,
      "text": "More humid air means more vapor, so muggy days mean a sweatier glass.",
      "words": 13,
      "words_per_s": 3.11,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l07",
      "start": 21.95,
      "end": 26.001,
      "text": "An insulated cup stays dry: its outer wall doesn't get that cold.",
      "words": 12,
      "words_per_s": 2.96,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l08",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
