    {
      "id": "l01",
      "start": 0.25,
      "end": 4.081,
      "text": "Why are microwaved leftovers hot at the edge, cold in the middle?",
      "words": 12,
      "words_per_s": 3.13,
      "voice_over_bed_db": 15.9
    },
    {
      "id": "l02",
      "start": 4.35,
      "end": 8.895,
      "text": "Waves bounce off the metal walls and overlap, leaving strong and weak spots.",
      "words": 13,
      "words_per_s": 2.86,
      "voice_over_bed_db": 14.9
    },
    {
      "id": "l03",
      "start": 9.15,
      "end": 17.154,
      "text": "The turntable carries food through them, but in thick food the waves mostly heat the outer layers; the middle waits for heat to spread inward.",
      "words": 25,
      "words_per_s": 3.12,
      "voice_over_bed_db": 15.4
    },
    {
      "id": "l04",
      "start": 18.3,
      "end": 23.079,
      "text": "So stir halfway, spread food evenly, and let it stand so the heat evens out.",
      "words": 15,
      "words_per_s": 3.14,
      "voice_over_bed_db": 16.9
    },
    {
      "id": "l05",
      "start": 26.45,
      "end": 29.739,
      "text": "Download Recall for learning any new subject with AI.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 16.8
    }
  ],
