  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.291,
      "text": "This straw isn't broken.",
      "words": 4,
      "words_per_s": 3.22,
      "voice_over_bed_db": 19.8
    },
    {
      "id": "l02",
      "start": 1.5,
      "end": 3.511,
      "text": "So why does it snap at the water's surface?",
      "words": 9,
      "words_per_s": 4.48,
      "voice_over_bed_db": 19.3
    },
    {
      "id": "l03",
      "start": 4.75,
      "end": 8.914,
      "text": "Light from the straw speeds up as it leaves the water, and changes direction.",
      "words": 14,
      "words_per_s": 3.36,
      "voice_over_bed_db": 17.9
    },
    {
      "id": "l04",
      "start": 9.2,
      "end": 13.529,
      "text": "Like a mower rolling from grass to pavement: one side speeds up first.",
      "words": 13,
      "words_per_s": 3.0,
      "voice_over_bed_db": 16.9
    },
    {
      "id": "l05",
      "start": 13.85,
      "end": 18.566,
      "text": "Your brain traces the light back in a straight line, so the underwater part looks higher.",
      "words": 16,
      "words_per_s": 3.39,
      "voice_over_bed_db": 17.5
    },
    {
      "id": "l06",
      "start": 20.4,
      "end": 24.995,
      "text": "That's why a pool looks shallower from above: about three quarters of its real depth.",
      "words": 15,
      "words_per_s": 3.26,
      "voice_over_bed_db": 15.5
    },
    {
      "id": "l07",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
