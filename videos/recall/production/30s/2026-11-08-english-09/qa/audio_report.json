  "lines": [
    {
      "id": "l01",
      "start": 0.45,
      "end": 2.943,
      "text": "Why does your phone ignore you once you put on gloves?",
      "words": 11,
      "words_per_s": 4.41,
      "voice_over_bed_db": 18.3
    },
    {
      "id": "l02",
      "start": 3.3,
      "end": 8.311,
      "text": "Your phone's screen is capacitive: it senses the electric charge of your fingertip.",
      "words": 13,
      "words_per_s": 2.59,
      "voice_over_bed_db": 17.9
    },
    {
      "id": "l03",
      "start": 8.6,
      "end": 13.661,
      "text": "Ordinary knit gloves don't conduct, so they isolate your finger and nothing registers.",
      "words": 13,
      "words_per_s": 2.57,
      "voice_over_bed_db": 16.9
    },
    {
      "id": "l04",
      "start": 14.05,
      "end": 18.668,
      "text": "Touchscreen gloves weave conductive thread into the fingertips to carry your touch through.",
      "words": 13,
      "words_per_s": 2.81,
      "voice_over_bed_db": 18.1
    },
    {
      "id": "l05",
      "start": 19.05,
      "end": 24.644,
      "text": "Resistive screens respond to pressure instead, so a gloved finger or plain stylus works.",
      "words": 14,
      "words_per_s": 2.5,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l06",
      "start": 26.35,
      "end": 29.639,
      "text": "Download Recall for learning any new subject with AI.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 16.6
    }
  ],
