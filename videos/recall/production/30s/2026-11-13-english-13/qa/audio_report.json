      "id": "l01",
      "start": 0.2,
      "end": 5.035,
      "text": "The elevator starts up, and the scale jumps from 75 to 84 kilos.",
      "words": 13,
      "words_per_s": 2.69,
      "voice_over_bed_db": 17.0
    },
    {
      "id": "l02",
      "start": 5.3,
      "end": 7.316,
      "text": "Did you gain nine kilos? No.",
      "words": 6,
      "words_per_s": 2.98,
      "voice_over_bed_db": 16.9
    },
    {
      "id": "l03",
      "start": 7.65,
      "end": 9.895,
      "text": "A scale reads how hard it pushes up on you.",
      "words": 10,
      "words_per_s": 4.45,
      "voice_over_bed_db": 18.1
    },
    {
      "id": "l04",
      "start": 10.25,
      "end": 13.32,
      "text": "To speed you up, it must push harder than gravity pulls.",
      "words": 11,
      "words_per_s": 3.58,
      "voice_over_bed_db": 16.1
    },
    {
      "id": "l05",
      "start": 13.7,
      "end": 16.561,
      "text": "At steady speed, the push matches gravity again.",
      "words": 8,
      "words_per_s": 2.8,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l06",
      "start": 16.95,
      "end": 19.921,
      "text": "Slowing at the top, it pushes less, so you read lighter.",
      "words": 11,
      "words_per_s": 3.7,
      "voice_over_bed_db": 17.4
    },
    {
      "id": "l07",
      "start": 20.4,
      "end": 24.749,
      "text": "Your mass never changed. Only the push did, while your speed was changing.",
      "words": 13,
      "words_per_s": 2.99,
      "voice_over_bed_db": 17.5
    },
    {
      "id": "l08",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
