  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.271,
      "text": "Hotter than boiling water.",
      "words": 4,
      "words_per_s": 3.28,
      "voice_over_bed_db": 17.1
    },
    {
      "id": "l02",
      "start": 1.45,
      "end": 4.878,
      "text": "A pressure cooker keeps water liquid above 100 degrees.",
      "words": 9,
      "words_per_s": 2.63,
      "voice_over_bed_db": 17.7
    },
    {
      "id": "l03",
      "start": 5.1,
      "end": 8.661,
      "text": "Water boils when its vapor pushes as hard as the air above it.",
      "words": 13,
      "words_per_s": 3.65,
      "voice_over_bed_db": 17.8
    },
    {
      "id": "l04",
      "start": 8.9,
      "end": 10.97,
      "text": "At sea level, that's 100 degrees.",
      "words": 6,
      "words_per_s": 2.9,
      "voice_over_bed_db": 18.7
    },
    {
      "id": "l05",
      "start": 11.2,
      "end": 14.606,
      "text": "Lock the lid, and steam can't escape, so the pressure rises.",
      "words": 11,
      "words_per_s": 3.23,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l06",
      "start": 14.85,
      "end": 18.23,
      "text": "So the water must reach about 120 degrees to boil.",
      "words": 10,
      "words_per_s": 2.96,
      "voice_over_bed_db": 18.8
    },
    {
      "id": "l07",
      "start": 18.5,
      "end": 20.135,
      "text": "Hotter water cooks food faster.",
      "words": 5,
      "words_per_s": 3.06,
      "voice_over_bed_db": 19.0
    },
    {
      "id": "l08",
      "start": 20.7,
      "end": 24.97,
      "text": "On a mountain it's the reverse: water boils cooler, so food cooks slower.",
      "words": 13,
      "words_per_s": 3.04,
      "voice_over_bed_db": 17.4
    },
    {
      "id": "l09",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.6
    }
  ],
