  "lines": [
    {
      "id": "l01",
      "start": 0.3,
      "end": 2.964,
      "text": "Why is the food steaming but the plate still cool?",
      "words": 10,
      "words_per_s": 3.75,
      "voice_over_bed_db": 17.9
    },
    {
      "id": "l02",
      "start": 3.35,
      "end": 8.476,
      "text": "Microwaves tug the water molecules inside food back and forth, and that makes heat.",
      "words": 14,
      "words_per_s": 2.73,
      "voice_over_bed_db": 17.6
    },
    {
      "id": "l03",
      "start": 8.85,
      "end": 13.973,
      "text": "Glass and microwave-safe ceramics barely absorb them; the hot food warms the plate.",
      "words": 13,
      "words_per_s": 2.54,
      "voice_over_bed_db": 16.2
    },
    {
      "id": "l04",
      "start": 14.35,
      "end": 19.701,
      "text": "But water soaked into porous clay or an iron-rich glaze can make pottery heat itself.",
      "words": 15,
      "words_per_s": 2.8,
      "voice_over_bed_db": 16.4
    },
    {
      "id": "l05",
      "start": 20.1,
      "end": 25.926,
      "text": "To test a dish, heat it empty beside a cup of water for one minute. If it stays cool, it's safe.",
      "words": 21,
      "words_per_s": 3.6,
      "voice_over_bed_db": 15.9
    },
    {
      "id": "l06",
      "start": 26.35,
      "end": 29.639,
      "text": "Download Recall for learning any new subject with AI.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 16.6
    }
  ],
