 "rows": [
  {
   "caption": "Why is the food steaming / but the plate still cool?",
   "start": 0.23,
   "end": 3.28,
   "first_word_s": 0.3,
   "last_word_s": 2.38,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "Microwaves tug the water molecules / inside food back and forth,",
   "start": 3.28,
   "end": 7.4,
   "first_word_s": 3.35,
   "last_word_s": 6.69,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "and that makes heat.",
   "start": 7.4,
   "end": 8.78,
   "first_word_s": 7.47,
   "last_word_s": 7.93,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "Glass and microwave-safe ceramics / barely absorb them;",
   "start": 8.78,
   "end": 12.38,
   "first_word_s": 8.85,
   "last_word_s": 11.45,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "the hot food warms the plate.",
   "start": 12.38,
   "end": 14.28,
   "first_word_s": 12.45,
   "last_word_s": 13.53,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "But water soaked into porous clay / or an iron-rich glaze",
   "start": 14.28,
   "end": 17.92,
   "first_word_s": 14.35,
   "last_word_s": 17.21,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "can make pottery heat itself.",
   "start": 17.92,
   "end": 20.03,
   "first_word_s": 17.99,
   "last_word_s": 19.03,
   "caption_lead_s": 0.07,
   "ok": true,
   "spoken": true
  },
  {
   "caption": "To test a dish, / heat it empty beside",
