  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.266,
      "text": "That hole is on purpose.",
      "words": 5,
      "words_per_s": 4.11,
      "voice_over_bed_db": 19.2
    },
    {
      "id": "l02",
      "start": 1.55,
      "end": 3.738,
      "text": "It decides which layer holds the cabin in.",
      "words": 8,
      "words_per_s": 3.66,
      "voice_over_bed_db": 17.5
    },
    {
      "id": "l03",
      "start": 4.65,
      "end": 8.341,
      "text": "Up high, cabin air pushes out much harder than the thin air outside.",
      "words": 13,
      "words_per_s": 3.52,
      "voice_over_bed_db": 17.3
    },
    {
      "id": "l04",
      "start": 8.75,
      "end": 10.476,
      "text": "The thick outer layer takes that push.",
      "words": 7,
      "words_per_s": 4.05,
      "voice_over_bed_db": 18.8
    },
    {
      "id": "l05",
      "start": 10.9,
      "end": 14.002,
      "text": "The hole lets cabin air into the gap behind the middle layer.",
      "words": 12,
      "words_per_s": 3.87,
      "voice_over_bed_db": 16.0
    },
    {
      "id": "l06",
      "start": 14.45,
      "end": 19.335,
      "text": "Equal pressure on both sides means that layer carries no load. It's the backup.",
      "words": 14,
      "words_per_s": 2.87,
      "voice_over_bed_db": 15.7
    },
    {
      "id": "l07",
      "start": 20.6,
      "end": 25.014,
      "text": "See fog between the layers? That's moist cabin air that came in through the hole.",
      "words": 15,
      "words_per_s": 3.4,
      "voice_over_bed_db": 16.0
    },
    {
      "id": "l08",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 16.9
    }
  ],
