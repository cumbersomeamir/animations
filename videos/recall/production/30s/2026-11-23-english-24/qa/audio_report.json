  "lines": [
    {
      "id": "l01",
      "start": 0.05,
      "end": 1.512,
      "text": "This window is a metal net.",
      "words": 6,
      "words_per_s": 4.11,
      "voice_over_bed_db": 17.6
    },
    {
      "id": "l02",
      "start": 1.75,
      "end": 4.416,
      "text": "Light gets through. So why don't the microwaves?",
      "words": 8,
      "words_per_s": 3.0,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l03",
      "start": 4.75,
      "end": 7.693,
      "text": "Microwaves are waves about twelve centimeters long.",
      "words": 7,
      "words_per_s": 2.38,
      "voice_over_bed_db": 18.3
    },
    {
      "id": "l04",
      "start": 7.95,
      "end": 12.09,
      "text": "The holes are only about a millimeter wide, over a hundred times smaller.",
      "words": 13,
      "words_per_s": 3.14,
      "voice_over_bed_db": 17.5
    },
    {
      "id": "l05",
      "start": 12.35,
      "end": 16.812,
      "text": "To waves that long, the net is like solid metal, so they bounce back inside.",
      "words": 15,
      "words_per_s": 3.36,
      "voice_over_bed_db": 16.8
    },
    {
      "id": "l06",
      "start": 17.05,
      "end": 21.64,
      "text": "Light waves are about two thousand times smaller than the holes, so they slip through.",
      "words": 15,
      "words_per_s": 3.27,
      "voice_over_bed_db": 16.5
    },
    {
      "id": "l07",
      "start": 21.9,
      "end": 25.409,
      "text": "So if the door is bent, or won't close firmly, stop using it.",
      "words": 13,
      "words_per_s": 3.7,
      "voice_over_bed_db": 16.9
    },
    {
      "id": "l08",
      "start": 26.45,
      "end": 29.733,
      "text": "Download Recall to turn your study material into lessons.",
      "words": 9,
      "words_per_s": 2.74,
      "voice_over_bed_db": 17.7
    }
  ],
