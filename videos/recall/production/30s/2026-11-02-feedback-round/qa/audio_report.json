  "lines": [
    {
      "id": "l01",
      "start": 0.25,
      "end": 3.237,
      "text": "How can a QR code still work with a logo in the middle?",
      "words": 13,
      "words_per_s": 4.35,
      "voice_over_bed_db": 16.0
    },
    {
      "id": "l02",
      "start": 4.1,
      "end": 9.111,
      "text": "It stores extra error-correction information, so a scanner can rebuild some missing data.",
      "words": 13,
      "words_per_s": 2.59,
      "voice_over_bed_db": 16.1
    },
    {
      "id": "l03",
      "start": 10.05,
      "end": 13.78,
      "text": "Those three large corner squares help it find and orient the code.",
      "words": 12,
      "words_per_s": 3.22,
      "voice_over_bed_db": 16.1
    },
    {
      "id": "l04",
      "start": 14.65,
      "end": 17.798,
      "text": "Cover too much, especially those markers, and it may fail.",
      "words": 10,
      "words_per_s": 3.18,
      "voice_over_bed_db": 17.3
    },
    {
      "id": "l05",
      "start": 20.1,
      "end": 22.036,
      "text": "A bigger logo isn't always better.",
      "words": 6,
      "words_per_s": 3.1,
      "voice_over_bed_db": 14.1
    },
    {
      "id": "l06",
      "start": 26.15,
      "end": 29.813,
      "text": "Follow Recall for the technology hiding in everyday life.",
      "words": 9,
      "words_per_s": 2.46,
      "voice_over_bed_db": 16.0
    }
  ],
