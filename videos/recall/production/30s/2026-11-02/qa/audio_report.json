  "lines": [
    {
      "id": "l01",
      "start": 0.4,
      "end": 1.511,
      "text": "A steel ball sinks.",
      "words": 4,
      "words_per_s": 3.6,
      "voice_over_bed_db": 9.0
    },
    {
      "id": "l02",
      "start": 1.85,
      "end": 2.997,
      "text": "A steel ship floats.",
      "words": 4,
      "words_per_s": 3.49,
      "voice_over_bed_db": 9.0
    },
    {
      "id": "l03",
      "start": 3.3,
      "end": 5.41,
      "text": "Same material. So what changes?",
      "words": 5,
      "words_per_s": 2.37,
      "voice_over_bed_db": 11.6
    },
    {
      "id": "l04",
      "start": 5.6,
      "end": 6.385,
      "text": "Make your guess.",
      "words": 3,
      "words_per_s": 3.82,
      "voice_over_bed_db": 13.0
    },
    {
      "id": "l05",
      "start": 8.65,
      "end": 13.411,
      "text": "Here's the answer: the ship's hollow shape displaces much more water for its weight.",
      "words": 14,
      "words_per_s": 2.94,
      "voice_over_bed_db": 10.3
    },
    {
      "id": "l06",
      "start": 13.75,
      "end": 14.968,
      "text": "The water pushes upward.",
      "words": 4,
      "words_per_s": 3.28,
      "voice_over_bed_db": 12.7
    },
    {
      "id": "l07",
      "start": 15.3,
      "end": 18.412,
      "text": "When that buoyant force balances the ship's weight, it floats.",
      "words": 10,
      "words_per_s": 3.21,
      "voice_over_bed_db": 11.8
    },
    {
      "id": "l08",
      "start": 18.65,
      "end": 21.766,
      "text": "Fill the hull with water, and the situation changes.",
      "words": 9,
      "words_per_s": 2.89,
      "voice_over_bed_db": 7.6
    },
    {
      "id": "l09",
      "start": 22.6,
      "end": 24.353,
      "text": "It's not that the steel became lighter.",
      "words": 7,
      "words_per_s": 3.99,
      "voice_over_bed_db": 11.1
    },
    {
      "id": "l10",
      "start": 24.85,
      "end": 26.177,
      "text": "The shape changed the balance.",
      "words": 5,
      "words_per_s": 3.77,
      "voice_over_bed_db": 12.2
    }
  ],
