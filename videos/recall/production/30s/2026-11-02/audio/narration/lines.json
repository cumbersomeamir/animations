  "lines": [
    {
      "id": "l01",
      "text": "A steel ball sinks.",
      "file": "l01.wav",
      "duration": 1.111,
      "sr": 24000,
      "words_per_s": 3.6
    },
    {
      "id": "l02",
      "text": "A steel ship floats.",
      "file": "l02.wav",
      "duration": 1.147,
      "sr": 24000,
      "words_per_s": 3.49
    },
    {
      "id": "l03",
      "text": "Same material. So what changes?",
      "file": "l03.wav",
      "duration": 2.11,
      "sr": 24000,
      "words_per_s": 2.37
    },
    {
      "id": "l04",
      "text": "Make your guess.",
      "file": "l04.wav",
      "duration": 0.785,
      "sr": 24000,
      "words_per_s": 3.82
    },
    {
      "id": "l05",
      "text": "Here's the answer: the ship's hollow shape displaces much more water for its weight.",
      "file": "l05.wav",
      "duration": 4.761,
      "sr": 24000,
      "words_per_s": 2.94
    },
    {
      "id": "l06",
      "text": "The water pushes upward.",
      "file": "l06.wav",
      "duration": 1.218,
      "sr": 24000,
      "words_per_s": 3.28
    },
    {
      "id": "l07",
      "text": "When that buoyant force balances the ship's weight, it floats.",
      "file": "l07.wav",
      "duration": 3.112,
      "sr": 24000,
      "words_per_s": 3.21
    },
    {
      "id": "l08",
      "text": "Fill the hull with water, and the situation changes.",
      "file": "l08.wav",
      "duration": 3.116,
      "sr": 24000,
      "words_per_s": 2.89
    },
    {
      "id": "l09",
      "text": "It's not that the steel became lighter.",
      "file": "l09.wav",
      "duration": 1.753,
      "sr": 24000,
      "words_per_s": 3.99
    },
    {
      "id": "l10",
      "text": "The shape changed the balance.",
      "file": "l10.wav",
      "duration": 1.327,
      "sr": 24000,
      "words_per_s": 3.77
    }
  ]
}