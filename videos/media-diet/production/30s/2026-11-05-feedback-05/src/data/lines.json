  "words": 11
 },
 {
  "id": "V3",
  "say": "\u0932\u093e\u0907\u0935 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u092f\u0930 \u092e\u0947\u0902, \u0915\u094d\u0930\u094b\u092e \u0915\u0947 \u0932\u0949\u0917\u093f\u0928 \u0914\u0930 \u092a\u0947\u092e\u0947\u0902\u091f \u0939\u093f\u0938\u094d\u0938\u0947 \u0905\u092c \u0905\u092a\u0928\u0947-\u0906\u092a \u091b\u093f\u092a \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
  "duration": 5.329,
  "words": 15
 },
 {
  "id": "V4",
  "say": "\u0938\u093e\u092e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u094b \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948, \u092a\u0930 \u0935\u0939\u093e\u0901 \u0916\u093e\u0932\u0940 \u092a\u0930\u094d\u0926\u093e\u0964",
