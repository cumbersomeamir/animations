 },
 {
  "id": "V2",
  "say": "\u091a\u094c\u0926\u0939 \u0905\u0915\u094d\u091f\u0942\u092c\u0930 \u0938\u0947 \u0917\u0942\u0917\u0932 \u0928\u0947 \u0910\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u092a\u0930 \u0928\u092f\u093e \u092c\u091a\u093e\u0935 \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e\u0964",
