  "words": 10
 },
 {
  "id": "V5",
  "say": "\u092f\u0939 \u0910\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u092a\u0902\u0926\u094d\u0930\u0939 \u0914\u0930 \u090a\u092a\u0930 \u0915\u0947 \u092b\u093c\u094b\u0928\u094b\u0902 \u092e\u0947\u0902 \u0906 \u0930\u0939\u093e \u0939\u0948\u0964",
  "duration": 3.54,
  "words": 11
 },
 {
  "id": "V6",
  "say": "\u0905\u092a\u0928\u093e \u0935\u0930\u094d\u091c\u093c\u0928 \u0926\u0947\u0916\u0947\u0902: \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938, \u0905\u092c\u093e\u0909\u091f \u092b\u093c\u094b\u0928, \u0910\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u0935\u0930\u094d\u091c\u093c\u0928\u0964",
