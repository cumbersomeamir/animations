[
 {
  "id": "V1",
  "say": "\u092a\u094d\u0932\u0947 \u092a\u094d\u0930\u094b\u091f\u0947\u0915\u094d\u091f \u092c\u0902\u0926 \u0915\u0930\u0915\u0947 \u092d\u0942\u0932 \u0917\u092f\u0947?",
  "duration": 2.261,
  "words": 6
 },
 {
  "id": "V2",
  "say": "\u0926\u094b \u0928\u0935\u0902\u092c\u0930 \u0915\u0947 \u0917\u0942\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u092c\u093e\u0926,",
  "duration": 3.108,
  "words": 9
 },
 {
  "id": "V3",
  "say": "\u092f\u0939 \u0915\u0941\u091b \u0938\u092e\u092f \u092c\u0902\u0926 \u0930\u0939\u093e, \u0924\u094b \u0910\u0902\u0921\u094d\u0930\u0949\u0907\u0921 \u092b\u093c\u094b\u0928 \u092a\u0930 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964",
  "duration": 4.258,
  "words": 12
 },
 {
  "id": "V4",
  "say": "\u092a\u094d\u0932\u0947 \u092a\u094d\u0930\u094b\u091f\u0947\u0915\u094d\u091f \u0910\u092a \u0915\u094b \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u092a\u0930 \u091c\u093e\u0901\u091a\u0924\u093e \u0939\u0948, \u0914\u0930 \u092b\u093c\u094b\u0928 \u0915\u094b \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
  "duration": 5.498,
  "words": 16
 },
 {
  "id": "V5",
  "say": "\u0916\u093c\u0924\u0930\u0928\u093e\u0915 \u0910\u092a \u092e\u093f\u0932\u0947, \u0924\u094b \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0947\u0924\u093e \u0939\u0948, \u0914\u0930 \u0909\u0938\u0947 \u092c\u0902\u0926 \u092f\u093e \u0939\u091f\u093e \u092d\u0940 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",
  "duration": 5.126,
  "words": 15
 },
 {
  "id": "V6",
  "say": "\u091a\u093e\u0932\u0942 \u0930\u0916\u0947\u0902: \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930, \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932, \u092a\u094d\u0932\u0947 \u092a\u094d\u0930\u094b\u091f\u0947\u0915\u094d\u091f, \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938\u0964",
  "duration": 3.486,
  "words": 8
 },
 {
  "id": "V7",
  "say": "\u091f\u0947\u0915\u094d\u0928\u094b\u0932\u0949\u091c\u0940 \u0938\u092e\u091d\u0928\u0940 \u0939\u094b, \u0924\u094b \u092e\u0940\u0921\u093f\u0906 \u0921\u093e\u0907\u091f \u092b\u093c\u0949\u0932\u094b \u0915\u0930\u0947\u0902\u0964",
  "duration": 3.281,
  "words": 8
 }
]