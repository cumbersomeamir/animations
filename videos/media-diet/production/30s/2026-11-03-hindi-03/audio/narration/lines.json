[
 {
  "id": "V1",
  "say": "\u092f\u0939 \u0924\u0938\u094d\u0935\u0940\u0930 \u0905\u0938\u0932\u0940 \u0939\u0948, \u092f\u093e \u090f\u0906\u0908 \u0915\u0940?",
  "duration": 2.399,
  "words": 7
 },
 {
  "id": "V2",
  "say": "\u091b\u092c\u094d\u092c\u0940\u0938 \u0905\u0915\u094d\u091f\u0942\u092c\u0930 \u0915\u0947 \u0910\u092a\u0932 \u0905\u092a\u0921\u0947\u091f, \u0906\u0908\u0913\u090f\u0938 \u0938\u0924\u094d\u0924\u093e\u0908\u0938 \u092a\u0949\u0907\u0902\u091f \u0926\u094b \u092e\u0947\u0902 \u0938\u0941\u0930\u093e\u0917 \u0939\u0948\u0964",
  "duration": 4.949,
  "words": 12
 },
 {
  "id": "V3",
  "say": "\u0906\u0908\u092b\u093c\u094b\u0928 \u0915\u0947 \u090f\u0906\u0908 \u091f\u0942\u0932 \u0938\u0947 \u092c\u0928\u0940 \u092f\u093e \u092c\u0926\u0932\u0940 \u0924\u0938\u094d\u0935\u0940\u0930\u094b\u0902 \u092e\u0947\u0902,",
  "duration": 3.596,
  "words": 10
 },
 {
  "id": "V4",
  "say": "\u0917\u0942\u0917\u0932 \u0915\u093e \u0905\u0926\u0943\u0936\u094d\u092f \u0938\u093f\u0902\u0925 \u0906\u0908 \u0921\u0940 \u0935\u0949\u091f\u0930\u092e\u093e\u0930\u094d\u0915 \u091c\u0941\u0921\u093c\u0924\u093e \u0939\u0948,",
  "duration": 3.8,
  "words": 9
 },
 {
  "id": "V5",
  "say": "\u092a\u0902\u0926\u094d\u0930\u0939 \u092a\u094d\u0930\u094b \u0914\u0930 \u092c\u093e\u0926 \u0915\u0947 \u0906\u0908\u092b\u093c\u094b\u0928 \u092a\u0930\u0964",
  "duration": 2.323,
  "words": 7
 },
 {
  "id": "V6",
  "say": "\u0917\u0942\u0917\u0932 \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915\u093c, \u0938\u093f\u0902\u0925 \u0906\u0908 \u0921\u0940 \u0921\u093f\u091f\u0947\u0915\u094d\u091f\u0930 \u0907\u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948\u0964",
  "duration": 4.083,
  "words": 10
 },
 {
  "id": "V7",
  "say": "\u0928\u093f\u0936\u093e\u0928 \u0928 \u092e\u093f\u0932\u0928\u093e, \u0905\u0938\u0932\u0940 \u0939\u094b\u0928\u0947 \u0915\u093e \u0938\u092c\u0942\u0924 \u0928\u0939\u0940\u0902\u0964",
  "duration": 2.917,
