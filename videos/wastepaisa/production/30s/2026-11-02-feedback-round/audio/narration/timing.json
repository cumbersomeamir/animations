    },
    {
      "id": "L2",
      "text": "Inside may be copper or aluminium, and the material changes its scrap value.",
      "start": 3.1,
      "duration": 5.033,
      "end": 8.133
    },
    {
      "id": "L3",
      "text": "A buyer also checks the insulation, grade and weight.",
      "start": 8.85,
      "duration": 3.157,
      "end": 12.007
    },
    {
      "id": "L4",
      "text": "Keep different cable types separate and ask how they're priced before selling.",
      "start": 12.9,
      "duration": 4.096,
      "end": 16.996
    },
    {
      "id": "L5",
      "text": "Never burn insulation to expose the metal. The smoke is toxic.",
      "start": 18.6,
