  "narration": [
    {
      "id": "h1",
      "start": 0.18,
      "end": 4.95,
      "say": "खुले लॉन में शादी, और अचानक बारिश? बैकअप प्लान तैयार रखिए."
    },
    {
      "id": "h2",
      "start": 5.13,
      "end": 8.29,
      "say": "पहला, सबके बैठने लायक छत वाली जगह."
    },
    {
      "id": "h3",
      "start": 8.47,
      "end": 13.71,
      "say": "दूसरा, बिजली योग्य इलेक्ट्रीशियन लगाए; बोर्ड ढके, तार पानी से दूर."
    },
    {
      "id": "h4",
      "start": 13.88,
      "end": 17.6,
      "say": "तीसरा, ढका रास्ता और फिसलन रोकने वाली चटाई."
    },
    {
      "id": "h5",
      "start": 17.78,
      "end": 22.22,
      "say": "चौथा, टेंट, कैटरर, डेकोर की बारिश वाली शर्तें लिखित में."
    },
    {
      "id": "h6",
      "start": 22.4,
      "end": 25.88,
      "say": "और पक्का कीजिए, किस समय बैकअप प्लान पर जाएँगे."
    },
    {
      "id": "h7",
      "start": 26.41,
      "end": 29.73,
      "say": "चेकलिस्ट के लिए प्लान माय वेडिंग डाउनलोड करें."
    }
