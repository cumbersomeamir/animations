    {
      "id": "name",
      "text": "\u0907\u0938\u0947 \u092a\u094d\u0932\u093e\u0928\u093f\u0902\u0917 \u092b\u093c\u0948\u0932\u0947\u0938\u0940 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902: \u0939\u092e \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093e\u092e \u0915\u094b \u092a\u0930\u092b\u093c\u0947\u0915\u094d\u091f \u0938\u094b\u091a\u0924\u0947 \u0939\u0948\u0902\u0964",
