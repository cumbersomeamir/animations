        ]
      ]
    },
    {
      "id": "example",
      "text": "\u092a\u093f\u091b\u0932\u0940 \u092c\u093e\u0930 \u0910\u0938\u093e \u0915\u093e\u092e \u092a\u091a\u092a\u0928 \u092e\u093f\u0928\u091f \u091a\u0932\u093e \u0925\u093e, \u0924\u094b \u0915\u0948\u0932\u0947\u0902\u0921\u0930 \u092e\u0947\u0902 \u092a\u0942\u0930\u093e \u090f\u0915 \u0918\u0902\u091f\u093e \u0930\u0916\u093f\u090f\u0964",
