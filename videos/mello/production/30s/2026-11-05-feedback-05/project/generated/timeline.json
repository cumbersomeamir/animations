    {
      "id": "real",
      "text": "\u092a\u0930 \u0905\u0938\u0932 \u092e\u0947\u0902, \u092c\u0940\u091a \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0915\u0941\u091b \u0906 \u091c\u093e\u0924\u093e \u0939\u0948\u0964",
