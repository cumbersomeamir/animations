        ]
      ]
    },
    {
      "id": "fix",
      "text": "\u0907\u0938\u0932\u093f\u090f, \u0905\u0902\u0926\u093e\u091c\u093c\u0947 \u0915\u0940 \u091c\u0917\u0939, \u092a\u093f\u091b\u0932\u0940 \u092c\u093e\u0930 \u0915\u093e \u0905\u0938\u0932\u0940 \u0938\u092e\u092f \u0926\u0947\u0916\u093f\u090f\u0964",
      "start": 12.15,
