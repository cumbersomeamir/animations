          2.195
        ]
      ]
    },
    {
      "id": "plan",
      "text": "\u0907\u0938\u0915\u0940 \u091c\u0917\u0939, \u0905\u0917\u0930\u2026 \u0924\u094b\u2026 \u0935\u093e\u0932\u0940 \u092f\u094b\u091c\u0928\u093e \u092c\u0928\u093e\u0907\u090f:",
      "start": 4.95,
      "end": 7.577,
      "pauses": [
        [
          5.695,
          5.8
        ]
      ]
    },
    {
      "id": "example",
      "text": "\u0930\u093e\u0924 \u0915\u0947 \u0916\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092e\u0948\u0902 \u092b\u093c\u094b\u0928 \u0926\u0938 \u092e\u093f\u0928\u091f \u0915\u0947 \u0932\u093f\u090f \u0936\u0947\u0932\u094d\u092b\u093c \u092a\u0930 \u0930\u0916 \u0926\u0942\u0901\u0917\u0940\u0964",
      "start": 8.1,
      "end": 12.259,
      "pauses": [
        [
          9.411,
          9.672
        ],
        [
          11.371,
          11.451
        ]
      ]
    },
    {
      "id": "mech",
      "text": "\u0916\u093e\u0928\u0947 \u0915\u093e \u0916\u093c\u0924\u094d\u092e \u0939\u094b\u0928\u093e \u0938\u0902\u0915\u0947\u0924 \u0939\u0948; \u092b\u093c\u094b\u0928 \u0936\u0947\u0932\u094d\u092b\u093c \u092a\u0930 \u0930\u0916\u0928\u093e, \u0915\u093e\u092e\u0964",
      "start": 12.85,
      "end": 16.304,
      "pauses": [
        [
          14.546,
          14.808
        ],
        [
          15.342,
          15.421
        ]
      ]
    },
    {
      "id": "why",
      "text": "\u0938\u0902\u0915\u0947\u0924 \u0906\u0924\u0947 \u0939\u0940, \u092b\u093c\u0948\u0938\u0932\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0924\u092f \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
      "start": 16.85,
      "end": 19.746,
      "pauses": [
        [
          17.83,
          18.074
        ]
      ]
    },
    {
      "id": "evidence",
      "text": "\u0915\u0908 \u0936\u094b\u0927\u094b\u0902 \u092e\u0947\u0902, \u0910\u0938\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u0938\u0947 \u0905\u092e\u0932 \u0915\u0930\u0928\u093e \u0906\u0938\u093e\u0928 \u0939\u0941\u0906, \u0939\u093e\u0932\u093e\u0901\u0915\u093f \u0939\u0930 \u092c\u093e\u0930 \u0928\u0939\u0940\u0902\u0964",
      "start": 20.3,
