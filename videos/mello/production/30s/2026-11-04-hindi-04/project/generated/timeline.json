    {
      "id": "hook",
      "text": "\u201c\u092e\u0948\u0902 \u0938\u094d\u0915\u094d\u0930\u0949\u0932 \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0942\u0901\u0917\u0940\u201d \u2014 \u0938\u093f\u0930\u094d\u092b\u093c \u0907\u0930\u093e\u0926\u093e \u0905\u0915\u094d\u0938\u0930 \u0915\u093e\u092b\u093c\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964",
      "start": 0.3,
      "end": 4.352,
