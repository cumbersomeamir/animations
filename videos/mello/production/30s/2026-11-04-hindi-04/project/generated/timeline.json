    },
    {
      "id": "cta",
      "text": "\u092e\u0947\u0932\u094b \u0915\u0947 \u0938\u093e\u0925 \u090f\u0915 \u092e\u093e\u0907\u0902\u0921\u092b\u0941\u0932 \u092c\u094d\u0930\u0947\u0915 \u0932\u0940\u091c\u093f\u090f\u0964",
