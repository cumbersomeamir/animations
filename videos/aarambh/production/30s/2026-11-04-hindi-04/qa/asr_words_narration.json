 "segments": [
  {
   "start": 0.0,
   "end": 4.52,
   "text": "द्रश्छ बादध किशोर लूई ब्रेल ने चे उभरे बिंधों की लिपि बनाई,"
  },
  {
   "start": 5.2,
   "end": 9.06,
   "text": "उनकी स्कूल में उभरे अख्षर चूकर पहचानना मуш्किल ठा."
  },
  {
   "start": 9.76,
   "end": 13.88,
   "text": "बार्भिये की लिपि में बारहा बिंधूते ब्रेलने इनहे आदा किया."
  },
  {
   "start": 13.88,
   "end": 19.88,
   "text": "बिन्दों की जगासे अख्षर बडलता है उपर निचे दो बिन्दों बी अगल बगल सी"
  },
  {
   "start": 19.88,
   "end": 24.6,
   "text": "सीख चीजे इस्तिमाल करने वाले के नाप से बनाये"
  },
  {
   "start": 24.6,
   "end": 29.52,
   "text": "आरंभ डानूर करे आजीविका के अजारो का साथ दे"
  }
 ],
