 "segments": [
  {
   "start": 0.0,
   "end": 4.52,
   "text": "द्रिश्ट बादध के शोर लूई ब्रेल ने चे अभ्रे बींदों की लिपी बनाई."
  },
  {
   "start": 5.2,
   "end": 9.06,
   "text": "उनकी सकूल में अभ्रे अक्षर चूकर पहज़ानना मुष्किल ता."
  },
  {
   "start": 9.76,
   "end": 13.88,
   "text": "बार भिये की लिपी में बारहा बींदु ते ब्रेल ने इने आदा किया."
  },
  {
   "start": 13.88,
   "end": 19.88,
   "text": "बिन्दों की जगासे अक्षर बडलता है उपर निचे दो बिन्दों भी अगल बगल सी"
  },
  {
   "start": 19.88,
   "end": 24.54,
   "text": "सीख चीजे इस्तिमाल करने वाले के नाप से बनाये"
  },
  {
   "start": 24.54,
   "end": 29.52,
   "text": "आरंभ डाओन लोड करे आजीविका के ओजारो का साथ दे"
  }
 ],
