 "segments": [
  {
   "start": 0.0,
   "end": 8.84,
   "text": "एक अबहनेत्री और एक संगित कार ने रेडियो का पेटेंट लिया, एक फ्रिक्वेसी वाला रेडियो तर्पीरो जाम हो सकता था."
  },
  {
   "start": 9.46,
   "end": 17.52,
   "text": "उपाई भेजने और पाने वाला सात-सात फ्रिक्वेसी बडले, प्यानो रोल जैसी दो समान पट्याताल मिलाती थी."
  },
  {
   "start": 18.52,
   "end": 24.72,
   "text": "नोसेना ने तब इसे नहीं अपनाया, सीक, हेडी और जोर्ज की तरहा, अलग अलग हुनर मिलाये."
  },
  {
   "start": 25.64,
   "end": 29.64,
   "text": "आरंभ डाउनलोड करे आजीविका के अजारो का सात्ते."
  }
 ],
