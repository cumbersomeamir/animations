 "segments": [
  {
   "start": 0.0,
   "end": 4.36,
   "text": "एक अबहनेत्री और एक संगित कार ने रेडियो का पेटेंट लिया"
  },
  {
   "start": 4.36,
   "end": 8.86,
   "text": "एक फ्रिक्वेसी वाला रेडियो तर्पीरो जाम हो सकता था"
  },
  {
   "start": 8.86,
   "end": 13.3,
   "text": "उपाई भेजने और पाने वाला साथ-साथ फ्रिक्वेसी बडले"
  },
  {
   "start": 13.3,
   "end": 17.56,
   "text": "प्यानो रोल जैसी तो समान पत्या ताल मिलाती थी"
  },
  {
   "start": 17.56,
   "end": 24.84,
   "text": "नोसेना ने तब इसे नहीं अपनाया, सीक, हेडी और जोर्ज की तरहा अलग अलग हुनर मिलाये"
  },
  {
   "start": 24.84,
   "end": 29.64,
   "text": "आरंभ डाओन लोड करे आजीविका के अजारो का साथ दे"
  }
 ],
