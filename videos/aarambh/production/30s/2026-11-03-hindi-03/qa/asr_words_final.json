  {
   "start": 0.0,
   "end": 5.82,
   "text": "उन्नीस्व्श्व्बास्ध्छ में जों गलें की उर्दान के अंक अईबिम कमपुट्रो ने निकाले"
  },
  {
   "start": 5.82,
   "end": 10.02,
   "text": "पर उस दोर के कमपुटर कभी कभी अटक जाते दे"
  },
  {
   "start": 10.02,
   "end": 16.98,
   "text": "गलें के कहने पर नासा की गनितगे केट्रीन जोनसन ने वही समीकरन हाथ से हलकिए"
  },
  {
   "start": 16.98,
   "end": 23.68,
   "text": "जांच के बाद उर्दान सबहल रही सीक जरूरी गरना की अलक से जांच कराए"
  },
  {
   "start": 25.02,
   "end": 29.56,
   "text": "आरंभ डाउनलोड करे आजीविका के अजारो का साथ दे"
  }
 ],
