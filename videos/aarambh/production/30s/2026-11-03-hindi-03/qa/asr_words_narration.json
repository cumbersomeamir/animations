 "segments": [
  {
   "start": 0.0,
   "end": 5.82,
   "text": "उन्नीस्वाँ बास्थ में जों गलें की उर्दान के अंक अईबिम कमपुट्रो ने निकाले."
  },
  {
   "start": 6.3,
   "end": 10.02,
   "text": "पर उस दोर के कमपुट्र कभी कभी अट्टक जाते दे."
  },
  {
   "start": 10.48,
   "end": 16.94,
   "text": "गलें के कहने पर नासा की गनितगे कैत्रीन जोनसन ने वही समीकरन हाथ से हलकिए."
  },
  {
   "start": 16.94,
   "end": 23.78,
   "text": "जांच के बाद उर्डान सबहल रही, सीक जरूरी गरना की अलक से जांच कराये."
  },
  {
   "start": 25.04,
   "end": 29.54,
   "text": "आरंभ डाउनलोड करे आजीविका के अजारो का साथ दे."
  }
 ],
