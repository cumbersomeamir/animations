  "scenes": [
    {"id": "S1", "start": 0,   "end": 144, "name": "Hook: the day rains down", "action": "Stickman sprints in, slide-catches a falling plate; glass, scale and alarm clock land on top in a wobbling tower; knees buckle."},
    {"id": "S2", "start": 144, "end": 256, "name": "Topple: the phone catches it all", "action": "Tower topples; giant phone springs up from the floor; each object arcs into the screen and becomes a tracker card; stickman falls on his bottom, gets up, wipes brow."},
    {"id": "S3", "start": 256, "end": 368, "name": "Morning: meals", "action": "Sun rises; table skids in; plate drops; he bites toast (crumbs); flicks meal chips into the phone; plate spins to lunch and dinner; ring fills; fist pump."},
    {"id": "S4", "start": 368, "end": 480, "name": "Midday: water", "action": "Table slides away; glass falls and is caught; two gulps; he steps to the phone and taps; droplets fill glass icons."},
    {"id": "S5", "start": 480, "end": 592, "name": "Afternoon: weight", "action": "Scale skids in; crouch, jump, land (impact, dust); needle overshoots and settles; reading dot flies onto the chart."},
    {"id": "S6", "start": 592, "end": 704, "name": "Evening: optional fasting", "action": "Sun sets; alarm clock drops on a string; he shoves the minute hand, it spins on, the fasting ring sweeps in sync; stars appear; yawn."},
    {"id": "S7", "start": 704, "end": 800, "name": "Night: private, on device", "action": "Giant phone shrinks into his hand; he hugs it to his chest; padlock pops and clicks shut."},
    {"id": "S8", "start": 800, "end": 900, "name": "End card", "action": "Circle wipe from the padlock; icon bounces in; NutriAI wordmark; Explore on Google Play button presses; stickman points and hops."}
  ],
